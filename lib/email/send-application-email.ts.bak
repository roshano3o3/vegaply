/**
 * Shared helper: sends one tailored application email to the candidate.
 *
 * Uses the Gmail nodemailer transport already wired via EMAIL_USER / EMAIL_PASS
 * (same pattern as /api/alert/route.ts).
 *
 * Called by:
 *   - app/api/daily-queue/apply/route.ts
 */

import nodemailer from "nodemailer";

export interface SendApplicationEmailInput {
  to:                  string;
  firstName:           string;
  jobTitle:            string;
  employerName:        string;
  applyLink:           string;
  secureApplyLink?:    string;
  matchScore:          number | null;
  tailoredResumeText:  string;
  coverLetterText:     string;
}

export async function sendApplicationEmail(
  input: SendApplicationEmailInput,
): Promise<void> {
  const apiUser = process.env.EMAIL_USER;
  const apiPass = process.env.EMAIL_PASS;
  if (!apiUser || !apiPass) throw new Error("EMAIL_USER or EMAIL_PASS not configured");

  const transporter = nodemailer.createTransport({
    service: "gmail",
    auth: { user: apiUser, pass: apiPass },
  });

  await transporter.sendMail({
    from:    `"Vegaply AI" <${apiUser}>`,
    to:      input.to,
    subject: `📋 Your tailored application for ${input.jobTitle} at ${input.employerName} — Vegaply`,
    html:    buildHtml(input),
  });
}

function buildHtml(input: SendApplicationEmailInput): string {
  const {
    firstName, jobTitle, employerName, applyLink, secureApplyLink,
    matchScore, tailoredResumeText, coverLetterText,
  } = input;

  const scoreClass  = matchScore === null ? "medium"
    : matchScore >= 70 ? "high"
    : matchScore >= 50 ? "medium"
    : "low";
  const scoreLabel  = matchScore !== null ? `${matchScore}%` : "—";

  // Escape HTML entities to prevent XSS in user-supplied content
  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const resumeHtml = esc(tailoredResumeText)
    .replace(/^(PROFESSIONAL SUMMARY|WORK EXPERIENCE|PROJECTS|EDUCATION|CERTIFICATIONS|SKILLS|ATS keywords integrated[^\n]*)/gm,
      "<strong>$1</strong>")
    .replace(/\n/g, "<br>");

  const letterHtml = esc(coverLetterText).replace(/\n/g, "<br>");

  return `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1a1a1a;line-height:1.6;background:#f5f5f5;margin:0;padding:24px 0}
  .wrap{max-width:640px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
  .hdr{background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#fff;padding:28px 32px}
  .hdr h1{margin:0 0 4px;font-size:21px}
  .hdr p{margin:0;opacity:.9;font-size:14px}
  .body{padding:28px 32px}
  .job-card{background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:16px 20px;margin-bottom:24px}
  .job-card .title{font-size:18px;font-weight:700;margin:0 0 4px}
  .job-card .co{color:#6b7280;font-size:14px;margin:0 0 12px}
  .badge{display:inline-block;padding:4px 12px;border-radius:999px;font-size:12px;font-weight:700}
  .badge.high{background:#d1fae5;color:#065f46}
  .badge.medium{background:#fef3c7;color:#92400e}
  .badge.low{background:#fee2e2;color:#991b1b}
  .sec{margin-bottom:24px}
  .sec-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#9ca3af;margin:0 0 8px}
  .textbox{background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:16px;font-size:14px;color:#374151;line-height:1.75}
  .cta{display:inline-block;background:#f59e0b;color:#fff;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:700;font-size:15px;margin-top:4px}
  .ftr{color:#9ca3af;font-size:12px;text-align:center;padding:20px 32px;border-top:1px solid #f3f4f6}
</style>
</head>
<body>
<div class="wrap">
  <div class="hdr">
    <h1>📋 Your application is ready</h1>
    <p>Tailored resume &amp; cover letter — copy, apply, and go.</p>
  </div>
  <div class="body">
    <p>Hi ${esc(firstName)},</p>
    <p>Vegaply prepared your tailored materials for this role. Review them below, then click <strong>Apply Now</strong>.</p>

    <div class="job-card">
      <p class="title">${esc(jobTitle)}</p>
      <p class="co">${esc(employerName)}</p>
      <span class="badge ${scoreClass}">Match ${scoreLabel}</span>
    </div>

    <div class="sec">
      <p class="sec-label">Cover Letter</p>
      <div class="textbox">${letterHtml}</div>
    </div>

    <div class="sec">
      <p class="sec-label">Tailored Resume</p>
      <div class="textbox">${resumeHtml}</div>
    </div>

    <a href="${esc(secureApplyLink ?? applyLink)}" class="cta">Review &amp; Apply →</a>

    <p style="margin-top:24px;font-size:13px;color:#6b7280">
      After you click Apply Now, Vegaply records that you opened the company application page.
    </p>
  </div>
  <div class="ftr">
    <p>Good luck! 🚀<br>— Vegaply Team &nbsp;·&nbsp; vegaply.com</p>
  </div>
</div>
</body>
</html>`;
}
